{
  "name": "learnforge",
  "private": true,
  "version": "0.2.2",
  "description": "A local-first Socratic learning harness with active recall, real code execution, LaTeX derivations, and FSRS-4.5 spaced repetition.",
  "author": "Oyetomi",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Oyetomi/learnforge.git"
  },
  "homepage": "https://github.com/Oyetomi/learnforge",
  "keywords": [
    "learning",
    "education",
    "spaced-repetition",
    "active-recall",
    "socratic-method",
    "tauri",
    "ai",
    "local-first"
  ],
  "type": "module",
  "scripts": {
    "prepare:vendors": "node scripts/prepare-sandbox-vendors.mjs",
    "postinstall": "node scripts/prepare-sandbox-vendors.mjs",
    "predev": "node scripts/prepare-sandbox-vendors.mjs",
    "dev": "vite",
    "prebuild": "node scripts/prepare-sandbox-vendors.mjs",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "pretest": "node scripts/prepare-sandbox-vendors.mjs",
    "test": "vitest run",
    "tauri": "tauri"
  },
  "dependencies": {
    "@dagrejs/dagre": "^3.1.3",
    "@monaco-editor/react": "^4.7.0",
    "@tauri-apps/api": "^2.2.0",
    "@tauri-apps/plugin-http": "^2.8.3",
    "@xmldom/xmldom": "^0.9.12",
    "@xyflow/react": "^12.12.0",
    "canvas-confetti": "^1.9.4",
    "d3": "^7.9.0",
    "highlight.js": "^11.12.0",
    "katex": "^0.16.21",
    "lucide-react": "^0.475.0",
    "mafs": "^0.21.0",
    "mermaid": "^12.2.0",
    "monaco-editor": "0.57.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^9.0.3",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.0",
    "remark-math": "^6.0.0",
    "roughjs": "^4.6.6",
    "three": "^0.187.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.2.0",
    "@types/canvas-confetti": "^1.9.0",
    "@types/d3": "^7.4.3",
    "@types/katex": "^0.16.7",
    "@types/node": "^26.6.5",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.5.2",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.3",
    "vite": "^6.1.0",
    "vitest": "^5.0.5"
  },
  "overrides": {
    "dompurify": "^3.4.17"
  }
