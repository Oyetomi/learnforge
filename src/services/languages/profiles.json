        "clang",
        "cc",
        "gcc"
      ],
      "clangd": [
        "clangd"
      ]
    },
    "readPaths": [],
    "env": {},
    "scaffold": [],
    "sourcePattern": "^(([a-z][a-z0-9_-]{0,40}/){0,4}[a-z][a-z0-9_-]{0,40}\\.[ch]|([a-z][a-z0-9_-]{0,40}/){0,4}[a-z0-9][a-z0-9_-]{0,40}\\.(txt|json|jsonl|xml|csv|md|yaml|yml|sql|proto|avsc))$",
