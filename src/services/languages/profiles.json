[
  {
    "id": "go",
    "name": "Go",
    "monaco": "go",
    "binaries": {
      "go": [
        "go"
      ],
      "gopls": [
        "gopls"
      ]
    },
    "readPaths": [
      "~/go"
    ],
    "env": {
      "GOCACHE": "{cache}/go-build",
      "GOPATH": "{cache}/gopath",
      "GOTOOLCHAIN": "local",
      "GOFLAGS": "-mod=mod",
      "CGO_ENABLED": "0",
      "GOTELEMETRY": "off"
    },
    "scaffold": [
      {
        "path": "go.mod",
        "content": "module learnforge\n\ngo 1.21\n"
      }
    ],
    "sourcePattern": "^([a-z][a-z0-9_]{0,40}/){0,2}([a-z][a-z0-9_]{0,40}\\.go|go\\.mod|go\\.sum)$",
    "testPattern": "_test\\.go$",
    "testFile": "stage{nn}_{slug}_test.go",
    "testNamePrefix": true,
    "entry": "main.go",
    "run": [
      [
        "{go}",
        "run",
        "."
      ]
    ],
    "test": [
      [
        "{go}",
        "test",
        "-count=1",
        "-run",
        "^TestStage{nn}",
        "./..."
      ]
    ],
    "lsp": [
      [
        "{gopls}"
      ]
    ],
    "lspInstall": "go install golang.org/x/tools/gopls@latest",
    "sourceGuide": "One Go module named learnforge (go.mod at the root, editable). The root package is package main; subfolders are packages imported as \"learnforge/<folder>\". Standard library only.",
    "testGuide": "One Go test file: package main, import \"testing\". Every top-level function is named TestStage{nn}… or stage{nn}… (helpers). No top-level types, variables or constants.",
    "lspProbe": [
      "version"
    ]
  },
  {
    "id": "python",
    "name": "Python",
    "monaco": "python",
    "binaries": {
      "python": [
        "python3"
      ],
      "pyright": [
        "pyright-langserver",
        "basedpyright-langserver"
      ],
      "pylsp": [
        "pylsp"
      ]
    },
    "readPaths": [
      "~/Library/Python"
    ],
    "env": {
      "PYTHONDONTWRITEBYTECODE": "1",
      "PYTHONPATH": "{project}"
    },
    "scaffold": [],
    "sourcePattern": "^([a-z][a-z0-9_]{0,40}/){0,2}([a-z][a-z0-9_]{0,40}|__init__)\\.py$",
    "testPattern": "^test_stage\\d{2}_[a-z0-9_]+\\.py$",
    "testFile": "test_stage{nn}_{slug}.py",
    "testNamePrefix": false,
    "entry": "main.py",
    "run": [
      [
        "{python}",
        "main.py"
      ]
    ],
    "test": [
      [
        "{python}",
        "-m",
        "unittest",
        "-v",
        "{testStem}"
      ]
    ],
    "lsp": [
      [
        "{pyright}",
        "--stdio"
      ],
      [
        "{pylsp}"
      ]
    ],
    "lspInstall": "npm install -g pyright",
    "sourceGuide": "Modules in the project root, standard library only. Import with `from store import Store`.",
    "testGuide": "One unittest file: `import unittest`, test classes subclass unittest.TestCase, test methods start with test_. Import the learner's modules by name.",
    "lspProbe": [
      "--version"
    ]
  },
  {
    "id": "rust",
    "name": "Rust",
    "monaco": "rust",
    "binaries": {
      "cargo": [
        "cargo"
      ],
      "rust-analyzer": [
        "rust-analyzer"
      ]
    },
    "readPaths": [
      "~/.cargo",
      "~/.rustup"
    ],
    "env": {
      "CARGO_TARGET_DIR": "{project}/target",
      "CARGO_NET_OFFLINE": "true"
    },
    "scaffold": [
      {
        "path": "Cargo.toml",
        "content": "[package]\nname = \"learnforge_project\"\nversion = \"0.1.0\"\nedition = \"2021\"\n\n[dependencies]\n"
      },
      {
        "path": "src/lib.rs",
        "content": "// Library code goes here. Declare new modules with `pub mod name;`.\n"
      },
      {
        "path": "src/main.rs",
        "content": "fn main() {\n    println!(\"learnforge project\");\n}\n"
      }
    ],
    "sourcePattern": "^src/([a-z][a-z0-9_]{0,40}/){0,2}[a-z][a-z0-9_]{0,40}\\.rs$",
    "testPattern": "^tests/stage\\d{2}_[a-z0-9_]+\\.rs$",
    "testFile": "tests/stage{nn}_{slug}.rs",
    "testNamePrefix": false,
    "entry": "src/main.rs",
    "run": [
      [
        "{cargo}",
        "run",
        "--offline",
        "--quiet"
      ]
    ],
    "test": [
      [
        "{cargo}",
        "test",
        "--offline",
        "--quiet",
        "--test",
        "{testStem}"
      ]
    ],
    "lsp": [
      [
        "{rust-analyzer}"
      ]
    ],
    "lspInstall": "rustup component add rust-analyzer",
    "sourceGuide": "A Cargo package named learnforge_project, standard library only. Library code lives in src/lib.rs and modules under src/; a new module file needs `pub mod name;` in src/lib.rs, which the task must tell the learner to add.",
    "testGuide": "One integration test file: `use learnforge_project::*;` (or specific module paths), then #[test] functions.",
    "lspProbe": [
      "--version"
    ]
  },
  {
    "id": "typescript",
    "name": "TypeScript",
    "monaco": "typescript",
    "binaries": {
      "node": [
        "node"
      ],
      "tsserver": [
        "typescript-language-server"
      ]
    },
    "readPaths": [],
    "env": {},
    "scaffold": [
      {
        "path": "package.json",
        "content": "{\n  \"type\": \"module\",\n  \"private\": true\n}\n"
      },
      {
        "path": "tsconfig.json",
        "content": "{\n  \"compilerOptions\": {\n    \"target\": \"ES2023\",\n    \"module\": \"NodeNext\",\n    \"strict\": true,\n    \"allowImportingTsExtensions\": true,\n    \"noEmit\": true,\n    \"types\": [\"node\"]\n  }\n}\n"
      }
    ],
    "sourcePattern": "^([a-z][a-z0-9_]{0,40}/){0,2}[a-z][a-z0-9_]{0,40}\\.ts$",
    "testPattern": "^stage\\d{2}_[a-z0-9_]+\\.test\\.ts$",
    "testFile": "stage{nn}_{slug}.test.ts",
    "testNamePrefix": false,
    "entry": "main.ts",
    "run": [
      [
        "{node}",
        "main.ts"
      ]
    ],
    "test": [
      [
        "{node}",
        "--test",
        "{testFile}"
      ]
    ],
    "lsp": [
      [
        "{tsserver}",
        "--stdio"
      ]
    ],
    "lspInstall": "npm install -g typescript typescript-language-server",
    "sourceGuide": "ES modules run directly by Node (type stripping): erasable TypeScript only (no enums or namespaces), and imports include the .ts extension, e.g. `import { Store } from \"./store.ts\";`. No npm packages.",
    "testGuide": "One node:test file: `import { test } from \"node:test\"; import assert from \"node:assert/strict\";` and import the learner's modules with .ts extensions.",
    "lspProbe": [
      "--version"
    ]
  },
