[
  {
    "id": "go",
    "name": "Go",
    "monaco": "go",
    "binaries": {
      "go": [
        "go"
      ],
      "gopls": [
        "gopls"
      ]
    },
    "readPaths": [
      "~/go"
    ],
    "env": {
      "GOCACHE": "{cache}/go-build",
      "GOPATH": "{cache}/gopath",
      "GOTOOLCHAIN": "local",
      "GOFLAGS": "-mod=mod",
      "CGO_ENABLED": "0",
      "GOTELEMETRY": "off"
    },
    "scaffold": [
      {
        "path": "go.mod",
        "content": "module learnforge\n\ngo 1.22\n"
      }
    ],
    "sourcePattern": "^([a-z][a-z0-9_-]{0,40}/){0,4}([a-z][a-z0-9_-]{0,40}\\.go|[a-z0-9][a-z0-9_-]{0,40}\\.(txt|json|jsonl|xml|csv|md|yaml|yml|sql|proto|avsc)|go\\.mod|go\\.sum|go\\.work)$",
    "testPattern": "^(?:[a-z][a-z0-9_-]{0,40}/){0,4}stage\\d{2,3}_[a-z0-9_]+_test\\.go$",
    "testFile": "stage{nn}_{slug}_test.go",
    "testNamePrefix": true,
    "entry": "main.go",
    "run": [
      [
        "{go}",
        "run",
        "."
      ]
    ],
    "test": [
      [
        "{go}",
        "test",
        "-count=1",
        "-run",
        "^TestStage{nn}",
        "./..."
      ]
    ],
    "testBatchFormat": "go-json",
    "testBatch": [
      [
        "{go}",
        "test",
        "-json",
        "-count=1",
        "./..."
      ]
    ],
    "fetchDeps": [
      [
        "{go}",
        "mod",
        "tidy"
      ],
      [
        "{go}",
        "mod",
        "download"
      ]
    ],
    "tools": [
      {
        "id": "test_all",
        "label": "All tests",
        "commands": [
          [
            "{go}",
            "test",
            "-v",
            "-count=1",
            "./..."
          ]
        ]
      },
      {
        "id": "race",
        "label": "Race detector",
        "env": {
          "CGO_ENABLED": "1"
        },
        "commands": [
          [
            "{go}",
            "test",
            "-race",
            "-count=1",
            "./..."
          ]
        ]
      },
      {
        "id": "cover",
        "label": "Coverage",
        "commands": [
          [
            "{go}",
            "test",
            "-cover",
            "-count=1",
            "./..."
          ]
        ]
      },
      {
        "id": "bench",
        "label": "Benchmarks",
        "commands": [
          [
            "{go}",
            "test",
            "-bench=.",
            "-benchmem",
            "-run=^$",
            "./..."
          ]
        ]
      },
      {
        "id": "vet",
        "label": "go vet",
        "commands": [
          [
            "{go}",
            "vet",
            "./..."
          ]
        ]
      }
    ],
    "lsp": [
      [
        "{gopls}"
      ]
    ],
    "lspInstall": "go install golang.org/x/tools/gopls@latest",
    "sourceGuide": "One Go module named learnforge (go.mod at the root, editable). Keep the root package as package main and organize domain or service packages under internal/<name>/ (or subfolders) imported as \"learnforge/internal/<name>\"; add cmd/<service>/main.go when building multiple executables. Prefer a single go.mod over go.work unless the book explicitly teaches multi-module workspaces. Data and schema fixtures (.txt, .json, .jsonl, .xml, .csv, .md, .yaml, .yml, .sql, .proto, .avsc) and learner-written *_test.go files are allowed. Standard library only unless external packages are explicitly enabled for the project.",
    "testGuide": "One Go test file: package main, import \"testing\". Every top-level function is named TestStage{nn}… or stage{nn}… (helpers). No top-level types, variables or constants.",
    "lspProbe": [
      "version"
    ],
    "check": [
      [
        "{go}",
        "test",
        "-count=1",
        "-run",
        "^$",
        "./..."
      ]
    ]
  },
  {
    "id": "python",
    "name": "Python",
    "monaco": "python",
    "binaries": {
      "python": [
        "python3"
      ],
      "pyright": [
        "pyright-langserver",
        "basedpyright-langserver"
      ],
      "pylsp": [
        "pylsp"
      ]
    },
    "readPaths": [
      "~/Library/Python"
    ],
    "env": {
      "PYTHONDONTWRITEBYTECODE": "1",
      "PYTHONPATH": "{project}:{project}/.lf-deps",
      "PIP_CACHE_DIR": "{cache}/pip"
    },
    "scaffold": [],
    "sourcePattern": "^(([a-z][a-z0-9_-]{0,40}/){0,4}([a-z][a-z0-9_]{0,40}|__init__)\\.py|([a-z][a-z0-9_-]{0,40}/){0,4}[a-z0-9][a-z0-9_-]{0,40}\\.(txt|json|jsonl|xml|csv|md|yaml|yml|sql|proto|avsc)|requirements\\.txt)$",
    "testPattern": "^test_stage\\d{2,3}_[a-z0-9_]+\\.py$",
    "testFile": "test_stage{nn}_{slug}.py",
    "testNamePrefix": false,
    "entry": "main.py",
    "run": [
      [
        "{python}",
        "main.py"
      ]
    ],
    "test": [
      [
        "{python}",
        "-m",
        "unittest",
        "-v",
        "{testStem}"
      ]
    ],
    "testBatchFormat": "python-unittest",
    "testBatch": [
      [
        "{python}",
        "-m",
        "unittest",
        "-v",
        "{testStems}"
      ]
    ],
    "fetchDeps": [
      [
        "{python}",
        "-m",
        "pip",
        "install",
        "--no-input",
        "--upgrade",
        "--target",
        "{project}/.lf-deps",
        "-r",
        "requirements.txt"
      ]
    ],
    "tools": [
      {
        "id": "test_all",
        "label": "All tests",
        "commands": [
          [
            "{python}",
            "-m",
            "unittest",
            "-v",
            "{testStems}"
          ]
        ]
      },
      {
        "id": "compileall",
        "label": "Syntax check",
        "commands": [
          [
            "{python}",
            "-m",
            "compileall",
            "-q",
            "."
          ]
        ]
      },
      {
        "id": "run_main",
        "label": "Run main",
        "commands": [
          [
            "{python}",
            "main.py"
          ]
        ]
      }
    ],
    "lsp": [
      [
        "{pyright}",
        "--stdio"
      ],
      [
        "{pylsp}"
      ]
    ],
    "lspInstall": "npm install -g pyright",
    "sourceGuide": "Python packages and modules under the project root (folders with __init__.py or namespace packages up to 4 levels deep). Import with `from broker.log import EventLog`. Data and schema fixtures (.txt, .json, .jsonl, .xml, .csv, .md, .yaml, .yml, .sql, .proto, .avsc) and requirements.txt are allowed. Standard library only unless external packages are explicitly enabled for the project.",
    "testGuide": "One unittest file: `import unittest`, test classes subclass unittest.TestCase, test methods start with test_. Import the learner's modules by name.",
    "lspProbe": [
      "--version"
    ],
    "check": [
      [
        "{python}",
        "-c",
        "import {testStem}"
      ]
    ]
  },
  {
    "id": "rust",
    "name": "Rust",
    "monaco": "rust",
    "binaries": {
      "cargo": [
        "cargo"
      ],
      "rust-analyzer": [
        "rust-analyzer"
      ]
    },
    "readPaths": [
      "~/.cargo",
      "~/.rustup"
    ],
    "env": {
      "CARGO_HOME": "{cache}/cargo",
      "CARGO_TARGET_DIR": "{project}/target",
      "CARGO_NET_OFFLINE": "true"
    },
    "scaffold": [
      {
        "path": "Cargo.toml",
        "content": "[package]\nname = \"learnforge_project\"\nversion = \"0.1.0\"\nedition = \"2021\"\n\n[dependencies]\n"
      },
      {
        "path": "src/lib.rs",
        "content": "// Library code goes here. Declare new modules with `pub mod name;`.\n"
      },
      {
        "path": "src/main.rs",
        "content": "fn main() {\n    println!(\"learnforge project\");\n}\n"
      }
    ],
    "sourcePattern": "^(src/([a-z][a-z0-9_-]{0,40}/){0,3}[a-z][a-z0-9_]{0,40}\\.rs|([a-z][a-z0-9_-]{0,40}/){0,4}[a-z0-9][a-z0-9_-]{0,40}\\.(txt|json|jsonl|xml|csv|md|yaml|yml|sql|proto|avsc)|Cargo\\.toml|Cargo\\.lock)$",
    "testPattern": "^tests/stage\\d{2,3}_[a-z0-9_]+\\.rs$",
    "testFile": "tests/stage{nn}_{slug}.rs",
    "testNamePrefix": false,
    "entry": "src/main.rs",
    "run": [
      [
        "{cargo}",
        "run",
        "--offline",
        "--quiet"
      ]
    ],
    "test": [
      [
        "{cargo}",
        "test",
        "--offline",
        "--quiet",
        "--test",
        "{testStem}"
      ]
    ],
    "testBatchFormat": "cargo",
    "testBatch": [
      [
        "{cargo}",
        "test",
        "--offline",
        "--no-fail-fast",
        "--tests"
      ]
    ],
    "fetchDepsEnv": {
      "CARGO_NET_OFFLINE": "false"
    },
    "fetchDeps": [
      [
        "{cargo}",
        "fetch"
      ]
    ],
    "tools": [
      {
        "id": "test_all",
        "label": "All tests",
        "commands": [
          [
            "{cargo}",
            "test",
            "--offline",
            "--no-fail-fast"
          ]
        ]
      },
      {
        "id": "check",
        "label": "cargo check",
        "commands": [
          [
            "{cargo}",
            "check",
            "--offline",
            "--all-targets"
          ]
        ]
      },
      {
        "id": "clippy",
        "label": "Clippy",
        "commands": [
          [
            "{cargo}",
            "clippy",
            "--offline",
            "--all-targets"
          ]
        ]
      },
      {
        "id": "run_main",
        "label": "Run main",
        "commands": [
          [
            "{cargo}",
            "run",
            "--offline",
            "--quiet"
          ]
        ]
      }
    ],
    "lsp": [
      [
        "{rust-analyzer}"
      ]
    ],
    "lspInstall": "rustup component add rust-analyzer",
    "sourceGuide": "A Cargo package named learnforge_project (Cargo.toml at the root, editable). Library code lives in src/lib.rs and nested modules under src/ (up to 4 path segments); a new module file needs `pub mod name;` in src/lib.rs (or its parent mod.rs), which the task must tell the learner to add. Data and schema fixtures (.txt, .json, .jsonl, .xml, .csv, .md, .yaml, .yml, .sql, .proto, .avsc) are allowed. Standard library only unless external crates are explicitly enabled for the project.",
    "testGuide": "One integration test file: `use learnforge_project::*;` (or specific module paths), then #[test] functions.",
    "lspProbe": [
      "--version"
    ],
    "check": [
      [
        "{cargo}",
        "test",
        "--offline",
        "--quiet",
        "--no-run",
        "--test",
        "{testStem}"
      ]
    ]
  },
  {
