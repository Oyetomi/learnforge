          ]
        ]
      },
      {
        "id": "run_main",
        "label": "Run main",
        "commands": [
          [
            "{node}",
            "main.ts"
          ]
        ]
      }
    ],
    "lsp": [
      [
        "{tsserver}",
        "--stdio"
      ]
    ],
    "lspInstall": "npm install -g typescript typescript-language-server",
    "sourceGuide": "ES modules run directly by Node (type stripping): erasable TypeScript only (no enums or namespaces), nested folders allowed (up to 4 levels), and relative imports include the .ts extension, e.g. `import { Store } from \"./internal/store.ts\";`. Data and schema fixtures (.txt, .json, .jsonl, .xml, .csv, .md, .yaml, .yml, .sql, .proto, .avsc) and package.json are allowed. Node built-ins only unless external npm packages are explicitly enabled for the project.",
    "testGuide": "One node:test file: `import { test } from \"node:test\"; import assert from \"node:assert/strict\";` and import the learner's modules with .ts extensions.",
    "lspProbe": [
      "--version"
    ],
    "check": []
  },
