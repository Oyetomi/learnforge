      ],
      [
        "{tmp}/program"
      ]
    ],
    "test": [
      [
        "{cc}",
        "-std=c17",
        "-Wall",
        "-o",
        "{tmp}/stage{nn}",
        "{testFile}",
        "{sources:.c!main.c}"
      ],
      [
        "{tmp}/stage{nn}"
      ]
    ],
    "lsp": [
      [
        "{clangd}"
      ]
    ],
    "lspInstall": "xcode-select --install",
    "sourceGuide": "C17, standard library only. main() lives only in main.c; other code in separate .c files with matching .h headers.",
    "testGuide": "One C file with its own main() that includes the learner's headers, checks behavior with assert or explicit checks, prints what failed, and returns nonzero on failure. It is compiled with every .c file except main.c.",
    "lspProbe": [
      "--version"
    ]
  },
