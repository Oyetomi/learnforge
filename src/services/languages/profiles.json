  {
    "id": "c",
    "name": "C",
    "monaco": "c",
    "binaries": {
      "cc": [
        "clang",
        "cc",
        "gcc"
      ],
      "clangd": [
        "clangd"
      ]
    },
    "readPaths": [],
    "env": {},
    "scaffold": [],
    "sourcePattern": "^([a-z][a-z0-9_]{0,40}/){0,2}[a-z][a-z0-9_]{0,40}\\.[ch]$",
    "testPattern": "^stage\\d{2}_[a-z0-9_]+_test\\.c$",
    "testFile": "stage{nn}_{slug}_test.c",
    "testNamePrefix": false,
    "entry": "main.c",
    "run": [
      [
